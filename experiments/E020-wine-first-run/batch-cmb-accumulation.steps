# Batch cmb-accumulation: place all armies, pass, repeat (Session B of the video walkthrough).
# E002 step language, run by runtime/iwp/driver/clicks.py once the launcher has reached the title
# screen. Coordinates are the 800x600 stage's (walkthroughs/coordinates.md). The click-driver
# never clicks inside a battle: every input below is a bottom-bar control or a board point that
# selects the country the placement goes to.
click! 100 585      # New Game (title screen)
settle
click! 565 532      # Play Game (setup screen)
settle
click! 533 311      # EASY
settle 4            # the computer players take their turns first
click 55 193        # a board point that selects a country to receive the placement
settle
click! 307 543      # ALL (place all armies)
click! 497 543      # PLACE (commit placement)
settle
click! 417 530      # PASS (end the human turn)
settle 4            # the computers attack; each attack is one exchange
click 55 193
click! 307 543
click! 497 543
settle
click! 417 530
settle 4
