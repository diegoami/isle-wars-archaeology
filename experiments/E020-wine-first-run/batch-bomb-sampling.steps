# Batch bomb-sampling: let the games run so the computer draws and trades the bomb (C-CRD-06 /
# Q-BON-08). No forced deal and no patched build: the bomb comes only from captures (C-CRD-01).
# E002 step language, run by runtime/iwp/driver/clicks.py once the launcher has reached the title
# screen. Three games, each ending by quitting to the title so a fresh game starts from the same
# baseline; the computer plays its turns while the human places and passes.
click! 100 585      # New Game (title screen)
settle
click! 565 532      # Play Game (setup screen)
settle
click! 533 311      # EASY
settle 4
click 55 193
click! 307 543      # ALL
click! 497 543      # PLACE
settle
click! 417 530      # PASS
settle 4
