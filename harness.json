{
  "worktreeRoot": "../{repo}-work",
  "models": {
    "deepseek-flash": {
      "id": "opencode-go/deepseek-v4.1-flash",
      "variant": "high",
      "family": "deepseek"
    },
    "deepseek-pro": {
      "id": "opencode-go/deepseek-v4-pro",
      "variant": "high",
      "family": "deepseek"
    },
    "zai-glm-5.3": {
      "id": "zai-coding-plan/glm-5.3",
      "variant": "low",
      "family": "glm"
    },
    "zai-glm-5.3-flash": {
      "id": "zai-coding-plan/glm-5.3-flash",
      "variant": "high",
      "family": "glm"
    },
    "luna": {
      "id": "openai/gpt-5.6-luna",
      "variant": "high",
      "family": "openai"
    },
    "luna-6": {
      "id": "openai/gpt-6-luna",
      "variant": "high",
      "family": "openai",
      "watch": "GPT-6 Luna draws on OpenAI's main pool with Sol: kept registered, outside every chain, never the reviewer (L51)."
    },
    "gpt-6-sol": {
      "id": "openai/gpt-6-sol",
      "variant": "low",
      "family": "openai"
    },
    "gpt-6.1-sol": {
      "id": "openai/gpt-6.1-sol",
      "variant": "low",
      "family": "openai"
    }
  },
  "implementer": {
    "agent": "implementer",
    "chain": [
      "zai-glm-5.3-flash"
    ],
    "claudeFallback": "sonnet",
    "startupTimeoutSec": 180,
    "idleTimeoutSec": 900,
    "totalTimeoutSec": 10800
  },
  "reviewer": {
    "agent": "reviewer",
    "chain": [
      "luna"
    ],
    "claudeFallback": "sonnet",
    "startupTimeoutSec": 180,
    "idleTimeoutSec": 600,
    "totalTimeoutSec": 3600,
    "hard": [
      "zai-glm-5.3",
      "deepseek-pro",
      "luna"
    ],
    "sol": "gpt-6.1-sol"
  },
  "jev": {
    "model": "jev-1.13",
    "baseUrl": "https://openrouter.ai/api",
    "apiKeyEnv": "OPENROUTER_API_KEY",
    "timeoutSec": 30,
    "targetPrecision": 0.95,
    "decisions": {
      "breaks-play": {
        "type": "noul",
        "instructionsFile": "docs/jev/breaks-play.md"
      }
    }
  },
  "providers": {
    "openrouter": {
      "baseUrl": "https://openrouter.ai/api",
      "apiKeyEnv": "OPENROUTER_API_KEY"
    },
    "elevenlabs": {
      "baseUrl": "https://api.elevenlabs.io",
      "apiKeyEnv": "ELEVENLABS_API_KEY"
    }
  }
}
